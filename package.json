{
  "name": "eleckoi-desktop",
  "version": "0.1.4",
  "description": "ElecKoi offline-first AI desktop client",
  "author": "ElecKoi",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/eleckoi/ElecKoi.git"
  },
  "homepage": "https://github.com/eleckoi/ElecKoi",
  "private": true,
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "build:workspace-runtime": "pnpm --filter @eleckoi/author-sdk build && pnpm --filter @eleckoi/compatibility-mvu build && pnpm --filter @eleckoi/dsh-runtime build",
    "postinstall": "pnpm build:workspace-runtime",
    "rebuild:electron": "electron-rebuild --force --only better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "check:electron-sqlite": "node scripts/check-electron-sqlite.mjs",
    "check:electron-dsh": "node scripts/check-electron-dsh-runtime.mjs",
    "generate:author-runtime-notices": "node scripts/generate-author-runtime-notices.mjs",
    "check:author-runtime-notices": "node scripts/generate-author-runtime-notices.mjs --check",
    "verify:packaged-dsh": "node scripts/verify-packaged-dsh-runtime.mjs",
    "build:native-frame": "node scripts/build-windows-native-frame.mjs",
    "predev": "pnpm build:workspace-runtime && pnpm rebuild:electron && pnpm build:native-frame",
    "dev": "electron-vite dev",
    "build": "pnpm check:architecture && pnpm check:database-schema && pnpm check:dsh-versions && pnpm check:dsh-runtime && pnpm check:licenses && pnpm check:author-runtime-notices && pnpm typecheck && electron-vite build && node scripts/check-built-preload.mjs && pnpm build:native-frame",
    "build:unpack": "pnpm build && pnpm rebuild:electron && pnpm check:electron-sqlite && pnpm check:electron-dsh && electron-builder --dir && pnpm verify:packaged-dsh",
    "build:win": "pnpm build && pnpm rebuild:electron && pnpm check:electron-sqlite && pnpm check:electron-dsh && electron-builder --win --x64 && pnpm verify:packaged-dsh",
    "prepreview": "pnpm rebuild:electron",
    "preview": "electron-vite preview",
    "pretypecheck": "pnpm build:workspace-runtime",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "pretest": "pnpm build:workspace-runtime && pnpm rebuild:node",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dsh-versions": "node scripts/check-dsh-versions.mjs",
    "check:dsh-runtime": "node scripts/check-dsh-runtime.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "check:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "db:generate": "node scripts/generate-common-schema.mjs",
    "check:database-schema": "node scripts/generate-common-schema.mjs --check",
    "webui:build": "node scripts/apply-patches.mjs && vite build --config src/web/vite.web.config.ts",
    "webui:poc": "node scripts/apply-patches.mjs && vite build --config src/web/vite.web.config.ts && node out/web/poc.mjs",
    "webui:serve": "node scripts/apply-patches.mjs && vite build --config src/web/vite.serve.config.ts && node out/web/serve.mjs",
    "webui:agent": "node scripts/apply-patches.mjs && vite build --config src/web/vite.agent.config.ts && node out/web/agent.mjs",
    "webui:typecheck": "tsc -p src/web/tsconfig.json",
    "check:upstream-diff": "node scripts/check-upstream-diff.mjs",
    "webui:media": "node scripts/apply-patches.mjs && vite build --config src/web/vite.media.config.ts && node out/web/media.mjs",
    "webui:multitenant": "node scripts/apply-patches.mjs && vite build --config src/web/vite.multitenant.config.ts && node out/web/multitenant.mjs",
    "webui:verify": "pnpm webui:typecheck && pnpm check:upstream-diff && pnpm webui:poc && pnpm webui:agent && pnpm webui:media && pnpm webui:avatar && pnpm webui:multitenant && pnpm webui:admin && pnpm webui:cardisolation && pnpm webui:csp && pnpm webui:cardimages && pnpm webui:chrome && pnpm webui:appearance && pnpm webui:proxy && pnpm webui:keys && pnpm webui:render && pnpm webui:mobile && pnpm webui:quota && pnpm webui:backup",
    "webui:cardisolation": "node scripts/apply-patches.mjs && vite build --config src/web/vite.cardisolation.config.ts && node out/web/cardisolation.mjs",
    "webui:csp": "node scripts/apply-patches.mjs && vite build --config src/web/vite.csp.config.ts && node out/web/csp.mjs",
    "webui:quota": "node scripts/apply-patches.mjs && vite build --config src/web/vite.quota.config.ts && node out/web/quota.mjs",
    "webui:cardimages": "node scripts/apply-patches.mjs && vite build --config src/web/vite.cardimages.config.ts && node out/web/cardimages.mjs",
    "webui:import-cards": "node scripts/apply-patches.mjs && vite build --config src/web/vite.importcards.config.ts && node out/web/importCards.mjs",
    "webui:backup": "node scripts/apply-patches.mjs && vite build --config src/web/vite.backup.config.ts && node out/web/backup.mjs",
    "webui:avatar": "node scripts/apply-patches.mjs && vite build --config src/web/vite.avatar.config.ts && node out/web/avatar.mjs",
    "webui:chrome": "node scripts/apply-patches.mjs && vite build --config src/web/vite.chrome.config.ts && node out/web/chrome.mjs",
    "webui:admin": "node scripts/apply-patches.mjs && vite build --config src/web/vite.admin.config.ts && node out/web/admin.mjs",
    "webui:appearance": "node scripts/apply-patches.mjs && vite build --config src/web/vite.appearance.config.ts && node out/web/appearance.mjs",
    "webui:proxy": "node scripts/apply-patches.mjs && vite build --config src/web/vite.proxy.config.ts && node out/web/proxy.mjs",
    "webui:keys": "node scripts/apply-patches.mjs && vite build --config src/web/vite.keys.config.ts && node out/web/keys.mjs",
    "webui:render": "node scripts/apply-patches.mjs && vite build --config src/web/vite.render.config.ts && node out/web/render.mjs",
    "webui:mobile": "node scripts/apply-patches.mjs && vite build --config src/web/vite.mobile.config.ts && node out/web/mobile.mjs"
  },
