# ElecKoi WebUI 部署配置样例
#
# 用法：复制成同目录下的 .env 再按需修改（compose 会自动读取它）
#   cp docker/.env.example docker/.env
#
# 全部变量都有默认值，只有 ELECKOI_MASTER_KEY 必须自己填。

# ── 必填：凭据加密主密钥 ──────────────────────────────────
# 生成方法：openssl rand -base64 32
#
# ⚠️ 生成后**永远不要更换**。它是唯一能解开用户已保存的 API Key 的东西，
#    换掉之后那些 Key 全部无法解密，且**无法恢复**（AES-GCM，没有后门）。
#    建议生成后立刻另存一份到密码管理器。
ELECKOI_MASTER_KEY=

# ── 监听地址 ──────────────────────────────────────────────
# 只给本机用就保持 127.0.0.1；要给局域网或公网访问，填该网卡的 IP
# （比 0.0.0.0 收敛，不会意外暴露到所有网卡）。
ELECKOI_BIND=127.0.0.1
ELECKOI_PORT_HOST=8790
# 卡片域用另一个端口：跨源隔离要求卡片域与应用域**不同源**，
# 同 IP 不同端口即可满足。
ELECKOI_CARD_PORT_HOST=8791

# ── 账号 ──────────────────────────────────────────────────
# 关闭自助注册（推荐）。账号池为空时仍然允许创建首个账号，且它自动成为管理员，
# 所以第一次部署不需要改这里就能进得去。
ELECKOI_ALLOW_REGISTRATION=0
# 启动时按邮箱提升为管理员，逗号分隔。例如：a@example.com,b@example.com
ELECKOI_ADMIN_EMAILS=

# ── 富内容卡片跨源隔离（公网必配）────────────────────────
# 角色卡是作者写的 HTML/JS，跑在 iframe 里。与应用同源时它能直接调用宿主
# 全部 IPC 接口；因此公网部署必须让卡片来自另一个源。
#
# ⚠️ 配了 ELECKOI_CARD_ORIGIN 就必须配 ELECKOI_APP_ORIGINS，否则服务启动即失败
#    （卡片帧会拒绝一切文档投递，表现为卡片全白）。
#
# 本地自用可以两个都留空：卡片与宿主同源，功能正常但不隔离。
# 公网示例：ELECKOI_CARD_ORIGIN=https://cards.example.com
#           ELECKOI_APP_ORIGINS=https://app.example.com,http://192.0.2.10:8790
ELECKOI_CARD_ORIGIN=
ELECKOI_APP_ORIGINS=

# ── 卡片图片：四种做法，改一个变量切换 ─────────────────────
# 卡片里的 <img src="https://某图床/x.png"> 默认会被卡片帧 CSP 拦掉（现象是图片位置全黑）。
#
#   ELECKOI_CARD_IMAGE_MODE=self-hosted   导入时传进你自己的图床（默认）
#   ELECKOI_CARD_IMAGE_MODE=local         导入时存到本地目录，由本服务在卡片源提供
#   ELECKOI_CARD_IMAGE_MODE=inline        导入时内联成 data: URI
#   ELECKOI_CARD_IMAGE_MODE=third-party   只放行第三方图床，不搬运
#   ELECKOI_CARD_IMAGE_MODE=off           什么都不做
#
# 对照（✅ 能显示 / 导出给别人也能看 / 数据去哪）：
#   self-hosted  自己✅ 别人✅  数据进你自己的服务器日志      —— 要自建图床（compose 已带可选的）
#   local        自己✅ 别人❌  不出你的机器                  —— 最省事且不需要白名单
#   inline       自己✅ 别人✅  不出你的机器                  —— 图写进卡片数据，只适合小图
#   third-party  自己✅ 别人✅  随图片请求发给第三方（不可控）  —— 只放行你信得过的域
#
# 详细说明与取舍见 docs/webui/卡片外链图片本地化.md
ELECKOI_CARD_IMAGE_MODE=self-hosted

# self-hosted / third-party 用：额外允许卡片加载的**源**（逗号分隔、纯源、不支持通配符）。
#   对：https://img.example.com:8443
#   错：https://img.example.com/album（带路径）、https://*.example.com（通配符）
# ⚠️ 只填**你自己控制**的域：放行哪个域就等于允许卡片把你的数据以图片请求发给它，
#    落进对方的访问日志——放行第三方公共图床等于交给一个你无法核实谁看得到的第三方。
ELECKOI_CARD_IMAGE_ORIGINS=

# self-hosted 用：图床对外地址 + 上传接口 + API 令牌（Zipline 后台生成）。三个都要。
ELECKOI_IMAGE_PUBLIC_BASE=
ELECKOI_IMAGE_UPLOAD_API=
ELECKOI_IMAGE_UPLOAD_TOKEN=

# local 用：图片目录（容器内路径）。默认就在数据卷里，**不需要任何额外配置**。
# 想放到别的大盘上：给 eleckoi-web 加一条挂载（见 compose.yml 里的注释），
# 并把这里改成对应的容器内路径；记得把宿主机目录属主改成 10001:10001。
ELECKOI_IMAGE_LOCAL_DIR=/data/card-images

# ── 导入时的搬运行为（四种做法共用）──────────────────────
# 搬运时机：inline（默认，导入等图片搬完才返回，界面有进度条）或 background
# （导入立刻返回、后台搬完自动刷新；只有搬运量极大、请求会顶到反向代理超时才需要）
ELECKOI_IMAGE_LOCALIZE_MODE=inline
# 同时搬运几张（4 路并发把几百张图从几分钟压到一分钟级）；调大更容易被图床限流
ELECKOI_IMAGE_CONCURRENCY=4
# 单次导入上限：张数 / 单图字节 / 总时间预算（毫秒）。超出的保留外链并记日志。
ELECKOI_IMAGE_MAX_PER_IMPORT=2000
ELECKOI_IMAGE_MAX_BYTES=20971520
ELECKOI_IMAGE_TIME_BUDGET_MS=900000
# inline 模式：单图内联上限，超过的保留外链（base64 会写进卡片数据，别设太大）
ELECKOI_IMAGE_INLINE_MAX_BYTES=262144
# 是否允许搬运本机地址（127.0.0.1/localhost）。默认否——卡里写死的本机地址
# 多半是卡作者自己的开发服务器；只在本机跑图床或做验收时才开。
ELECKOI_IMAGE_ALLOW_LOCAL=0

#   对：ELECKOI_CARD_IMAGE_ORIGINS=https://img.example.com:8443,http://192.0.2.10:9000
#   错：https://img.example.com/album   （带路径）
#       https://*.example.com          （通配符）
#
# ⚠️ 只填**你自己控制**的域。放行哪个域，就等于允许卡片把你的数据以图片请求
#    的形式发给那个域——数据会落进对方的访问日志：放行自己的服务器，只有你看得到；
#    放行第三方公共图床（postimg.cc 之类），就等于交给一个你既不了解保存多久、
#    也无法核实谁看得到的第三方。
#
# 配套工具 docker/rewrite-card-images.mjs 可以把卡片里已有的外链图片
# 批量下载到你自己的图床并改写引用，详见 docs/webui/卡片外链图片本地化.md。
ELECKOI_CARD_IMAGE_ORIGINS=

# ── 可选：自带图床（Zipline）──────────────────────────────
# 只有启用 `--profile images` 时才需要这些。启用后别人能凭邀请码注册、上传、
# 拿到稳定的图片链接；角色卡里那些随时会失效的外链图片也就有了自己的家。
# 详见 docs/webui/卡片外链图片本地化.md。

# 图床数据库密码（两个容器共用这一份，避免同一个密码写两处）：
#   openssl rand -base64 24 | tr -dc A-Za-z0-9 | cut -c -24
ZIPLINE_DB_PASSWORD=
# 会话与 API 令牌的签名密钥。**换掉它会让所有人登出、已发的令牌全部失效。**
#   openssl rand -base64 42 | tr -dc A-Za-z0-9 | cut -c -32
ZIPLINE_CORE_SECRET=

# 站点标题
ZIPLINE_TITLE=ElecKoi 图床
# 图床对外域名。⚠️ 你的公网入口是非标端口（Lucky 的 57789），所以这里必须带上端口，
# 否则图床在页面上给出的链接会漏掉端口、点开是打不开的。
# 注意它的优先级**高于**请求里的域名：填了就一律用它，内网直连调试时给的也是这个地址。
ZIPLINE_DEFAULT_DOMAIN=img.kidamita.top:57789

# ⚠️ 注册开关——这两个很容易配反，配反的后果是「任何人都能注册」：
#     注册时若**没带邀请码**，服务只看 ZIPLINE_USER_REGISTRATION：
#       为 true  → 直接放行  ← 邀请码形同虚设，公网别这么配
#       为 false → 拒绝（E1037）
#     注册时若**带了邀请码**，只看 ZIPLINE_INVITES_ENABLED。
#   所以「必须持邀请码才能注册」= USER_REGISTRATION **false** + INVITES **true**
#   （也就是下面的默认值，已实测确认）。
ZIPLINE_USER_REGISTRATION=false
ZIPLINE_INVITES_ENABLED=true

# 单文件上限（带单位的字符串）与单次上传文件数上限
ZIPLINE_MAX_FILE_SIZE=20mb
ZIPLINE_MAX_FILES_PER_UPLOAD=10

# 图床数据目录（宿主机的**实际路径**）。图床会长大，建议指到你自己的大盘上；
# 目录不存在时 Docker 会自动创建。里面有 pgdata / uploads / public / themes。
ZIPLINE_DATA_DIR=/var/lib/eleckoi-zipline

# 图床绑定的地址与端口（默认跟主站同一个网卡、8792 端口）
ELECKOI_IMAGES_BIND=
ELECKOI_IMAGES_PORT_HOST=8792
