# ElecKoi WebUI 部署配置样例
#
# 用法：复制成同目录下的 .env 再按需修改（compose 会自动读取它）
#   cp docker/.env.example docker/.env
#
# 全部变量都有默认值，只有 ELECKOI_MASTER_KEY 必须自己填。

# ── 必填：凭据加密主密钥 ──────────────────────────────────
# 生成方法：openssl rand -base64 32
#
# ⚠️ 生成后**永远不要更换**。它是唯一能解开用户已保存的 API Key 的东西，
#    换掉之后那些 Key 全部无法解密，且**无法恢复**（AES-GCM，没有后门）。
#    建议生成后立刻另存一份到密码管理器。
ELECKOI_MASTER_KEY=

# ── 监听地址 ──────────────────────────────────────────────
# 只给本机用就保持 127.0.0.1；要给局域网或公网访问，填该网卡的 IP
# （比 0.0.0.0 收敛，不会意外暴露到所有网卡）。
ELECKOI_BIND=127.0.0.1
ELECKOI_PORT_HOST=8790
# 卡片域用另一个端口：跨源隔离要求卡片域与应用域**不同源**，
# 同 IP 不同端口即可满足。
ELECKOI_CARD_PORT_HOST=8791

# ── 账号 ──────────────────────────────────────────────────
# 关闭自助注册（推荐）。账号池为空时仍然允许创建首个账号，且它自动成为管理员，
# 所以第一次部署不需要改这里就能进得去。
ELECKOI_ALLOW_REGISTRATION=0
# 启动时按邮箱提升为管理员，逗号分隔。例如：a@example.com,b@example.com
ELECKOI_ADMIN_EMAILS=

# ── 富内容卡片跨源隔离（公网必配）────────────────────────
# 角色卡是作者写的 HTML/JS，跑在 iframe 里。与应用同源时它能直接调用宿主
# 全部 IPC 接口；因此公网部署必须让卡片来自另一个源。
#
# ⚠️ 配了 ELECKOI_CARD_ORIGIN 就必须配 ELECKOI_APP_ORIGINS，否则服务启动即失败
#    （卡片帧会拒绝一切文档投递，表现为卡片全白）。
#
# 本地自用可以两个都留空：卡片与宿主同源，功能正常但不隔离。
# 公网示例：ELECKOI_CARD_ORIGIN=https://cards.example.com
#           ELECKOI_APP_ORIGINS=https://app.example.com,http://192.0.2.10:8790
ELECKOI_CARD_ORIGIN=
ELECKOI_APP_ORIGINS=

# ── 卡片外链图片 ──────────────────────────────────────────
# 卡片里的 <img src="https://图床/xx.png"> 默认会被卡片帧的 CSP 拦掉，
# 表现为「图片位置全黑」，并不是卡片坏了。
# 想让卡片能加载某个图床/相册站的图片，把它的**源**填在这里（逗号分隔）。
#
# 只接受纯源（scheme://host[:port]），不要带路径、查询串或通配符：
#   对：ELECKOI_CARD_IMAGE_ORIGINS=https://img.example.com
#   对：ELECKOI_CARD_IMAGE_ORIGINS=https://img.example.com:8443,http://192.0.2.10:9000
#   错：https://img.example.com/album   （带路径）
#       https://*.example.com          （通配符）
#
# ⚠️ 只填你自己的图床。放行第三方公共图床（如 postimg.cc）等于允许卡片把
#    聊天内容传给外人——那类站点任何人可读，放行它就把数据泄漏出去了；
#    放行自己的图床，泄漏最多落在你自己的访问日志里。
#
# 配套工具 docker/rewrite-card-images.mjs 可以把卡片里已有的外链图片
# 批量下载到你自己的图床并改写引用，详见 docs/webui/卡片外链图片本地化.md。
ELECKOI_CARD_IMAGE_ORIGINS=

# ── 可选：自带图床（Zipline）──────────────────────────────
# 只有启用 `--profile images` 时才需要这些。启用后别人能凭邀请码注册、上传、
# 拿到稳定的图片链接；角色卡里那些随时会失效的外链图片也就有了自己的家。
# 详见 docs/webui/卡片外链图片本地化.md。

# 图床数据库密码（两个容器共用这一份，避免同一个密码写两处）：
#   openssl rand -base64 24 | tr -dc A-Za-z0-9 | cut -c -24
ZIPLINE_DB_PASSWORD=
# 会话与 API 令牌的签名密钥。**换掉它会让所有人登出、已发的令牌全部失效。**
#   openssl rand -base64 42 | tr -dc A-Za-z0-9 | cut -c -32
ZIPLINE_CORE_SECRET=

# 站点标题
ZIPLINE_TITLE=ElecKoi 图床
# 图床对外域名（只影响从内网直连调试时生成的链接；经反代访问时用请求里的域名）
ZIPLINE_DEFAULT_DOMAIN=img.kidamita.top

# ⚠️ 注册开关——这两个很容易配反，配反的后果是「任何人都能注册」：
#     注册时若**没带邀请码**，服务只看 ZIPLINE_USER_REGISTRATION：
#       为 true  → 直接放行  ← 邀请码形同虚设，公网别这么配
#       为 false → 拒绝（E1037）
#     注册时若**带了邀请码**，只看 ZIPLINE_INVITES_ENABLED。
#   所以「必须持邀请码才能注册」= USER_REGISTRATION **false** + INVITES **true**
#   （也就是下面的默认值，已实测确认）。
ZIPLINE_USER_REGISTRATION=false
ZIPLINE_INVITES_ENABLED=true

# 单文件上限（带单位的字符串）与单次上传文件数上限
ZIPLINE_MAX_FILE_SIZE=20mb
ZIPLINE_MAX_FILES_PER_UPLOAD=10

# 图床绑定的地址与端口（默认跟主站同一个网卡、8792 端口）
ELECKOI_IMAGES_BIND=
ELECKOI_IMAGES_PORT_HOST=8792
