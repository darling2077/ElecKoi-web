# ElecKoi WebUI 部署配置样例
#
# 用法：复制成同目录下的 .env 再按需修改（compose 会自动读取它）
#   cp docker/.env.example docker/.env
#
# 全部变量都有默认值，只有 ELECKOI_MASTER_KEY 必须自己填。

# ── 必填：凭据加密主密钥 ──────────────────────────────────
# 生成方法：openssl rand -base64 32
#
# ⚠️ 生成后**永远不要更换**。它是唯一能解开用户已保存的 API Key 的东西，
#    换掉之后那些 Key 全部无法解密，且**无法恢复**（AES-GCM，没有后门）。
#    建议生成后立刻另存一份到密码管理器。
ELECKOI_MASTER_KEY=

# ── 监听地址 ──────────────────────────────────────────────
# 只给本机用就保持 127.0.0.1；要给局域网或公网访问，填该网卡的 IP
# （比 0.0.0.0 收敛，不会意外暴露到所有网卡）。
ELECKOI_BIND=127.0.0.1
ELECKOI_PORT_HOST=8790
# 卡片域用另一个端口：跨源隔离要求卡片域与应用域**不同源**，
# 同 IP 不同端口即可满足。
ELECKOI_CARD_PORT_HOST=8791

# ── 账号 ──────────────────────────────────────────────────
# 关闭自助注册（推荐）。账号池为空时仍然允许创建首个账号，且它自动成为管理员，
# 所以第一次部署不需要改这里就能进得去。
ELECKOI_ALLOW_REGISTRATION=0
# 启动时按邮箱提升为管理员，逗号分隔。例如：a@example.com,b@example.com
ELECKOI_ADMIN_EMAILS=

# ── 富内容卡片跨源隔离（公网必配）────────────────────────
# 角色卡是作者写的 HTML/JS，跑在 iframe 里。与应用同源时它能直接调用宿主
# 全部 IPC 接口；因此公网部署必须让卡片来自另一个源。
#
# ⚠️ 配了 ELECKOI_CARD_ORIGIN 就必须配 ELECKOI_APP_ORIGINS，否则服务启动即失败
#    （卡片帧会拒绝一切文档投递，表现为卡片全白）。
#
# 本地自用可以两个都留空：卡片与宿主同源，功能正常但不隔离。
# 公网示例：ELECKOI_CARD_ORIGIN=https://cards.example.com
#           ELECKOI_APP_ORIGINS=https://app.example.com,http://192.0.2.10:8790
ELECKOI_CARD_ORIGIN=
ELECKOI_APP_ORIGINS=

# ── 反向代理与 HTTPS ──────────────────────────────────────
# 挂在反向代理后面时开启。作用：从 X-Forwarded-For 取真实客户端 IP（限流按它计），
# 并让 X-Forwarded-Proto: https 生效使 Cookie 自动带 Secure。
# 不开的后果：所有公网用户共用一个代理 IP，累计十次失败就全站 429 十五分钟。
ELECKOI_TRUST_PROXY=0
# 强制所有 Cookie 带 Secure。**只在确定服务只经 HTTPS 访问时**才设为 1——
# 带 Secure 的 Cookie 在明文连接上会被浏览器直接丢弃，会让局域网 http 访问登录不上。
# 通常不必设：开启 ELECKOI_TRUST_PROXY 后，服务会按每次请求是否 HTTPS 自动判定。
ELECKOI_SECURE_COOKIES=0

# ── 资源 ──────────────────────────────────────────────────
# 每用户同时进行的 Agent 回合上限；每个回合一个 node 子进程，是主要资源消耗。
ELECKOI_MAX_CONCURRENT_RUNS=2
# 某用户多久无引用后回收其运行时（释放 SQLite 句柄与 Agent 子进程），单位分钟。
ELECKOI_TENANT_IDLE_MINUTES=30
# 同时存活的租户上限，超过时淘汰最久未用的空闲租户。
ELECKOI_MAX_LIVE_TENANTS=50

# ── 合规 ──────────────────────────────────────────────────
# AGPL-3.0 §13：以网络提供服务时，必须向使用者提供**本版本**的对应源码地址。
# 留空时服务会打印警告，并在登录页省略该入口。
# 部署自己的构建时，请填你这份源码的地址（建议指向具体 tag 而非分支）。
ELECKOI_SOURCE_URL=
