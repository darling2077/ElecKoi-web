{
  "schemaVersion": 1,
  "upstream": {
    "repository": "https://github.com/deepseek-ai/deepseek-harness.git",
    "commit": "fb2c4b9e698e30edb738bca4cf0618587db7d203",
    "version": "0.1.5-rc.2"
  },
  "transport": "stdio-jsonrpc",
  "entrypoint": "@deepseek-ai/dsh/package.json",
  "composition": "cordis.yml",
  "localPlugins": [
    "./agent-preset-bridge.mjs",
    "./tavily-web-search.mjs"
  ],
  "localModules": [
    "./conversation-context.mjs",
    "./request-config.mjs",
    "./session-snapshot.mjs",
    "./tool-policy.mjs"
  ],
  "plugins": [
    "@deepseek-ai/dsh-agent-presets"
  ],
  "presetComposition": "agent-preset-template/agent.cordis.yml",
  "presetLocalPlugins": [
    "./roleplay-plan-tool.mjs",
    "./setting-library-tools.mjs",
    "./variable-tools.mjs"
  ],
  "presetPlugins": [
    "@deepseek-ai/dsh-agent-instructions",
    "@deepseek-ai/dsh-command-compact",
    "@deepseek-ai/dsh-compaction-basic",
    "@deepseek-ai/dsh-compaction-tool-result-pruner",
    "@deepseek-ai/dsh-fs-observation-policy",
    "@deepseek-ai/dsh-skill-filesystem",
    "@deepseek-ai/dsh-tool-fs",
    "@deepseek-ai/dsh-tool-goal",
    "@deepseek-ai/dsh-tool-jobs",
    "@deepseek-ai/dsh-tool-pwsh",
    "@deepseek-ai/dsh-tool-skill",
    "@deepseek-ai/dsh-tool-subagent",
    "@deepseek-ai/dsh-tool-subagent-control",
    "@deepseek-ai/dsh-tool-subagent-control/list-agents",
    "@deepseek-ai/dsh-tool-todo",
    "@deepseek-ai/dsh-tool-web",
    "@deepseek-ai/dsh-tool-workflow",
    "@deepseek-ai/dsh-workflow-worker-thread"
  ],
  "capabilities": {
    "streaming": true,
    "durableSessions": true,
    "powershell": true,
    "filesystem": true,
    "skills": true,
    "jobs": true,
    "goals": true,
    "subagents": true,
    "workflows": true,
    "compaction": true,
    "variables": true,
    "settingLibrary": true,
    "conversationContext": true,
    "approvalAudit": true,
    "imageInput": true,
    "agentPresets": true,
    "webSearch": true,
    "webFetch": true
  }
}
